{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameShelf",
  "version": "0.1.0",
  "identifier": "app.gameshelf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameShelf",
        "width": 1380,
        "height": 900,
        "minWidth": 860,
        "minHeight": 640,
        "backgroundColor": "#10120f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "All your games, on one shelf",
    "category": "Entertainment"
  }
}
